{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo-optimizer:rule-authoring-schema:1.2.0",
  "title": "Geo Optimizer Rule",
  "description": "Authoring schema for Rule Admin UI. Runtime validation remains authoritative for UTF-8 byte budgets and hot-path safety.",
  "x-schemaArtifactVersion": "1.2.0",
  "x-ruleWireSchemaVersions": ["1.0", "1.1", "1.2"],
  "type": "object",
  "required": [
    "schema_version",
    "rule_id",
    "name",
    "type",
    "scope",
    "priority",
    "enabled",
    "version",
    "status",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1", "1.2"],
      "description": "Use 1.1 or later for relocate_element and 1.2 for flatten separators. Older versions remain accepted for existing rules."
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "\\S",
      "x-maxUtf8Bytes": 96
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S",
      "x-maxUtf8Bytes": 160
    },
    "type": {
      "type": "string",
      "enum": [
        "selector_remove",
        "attribute_filter",
        "text_token_remove",
        "text_phrase_remove",
        "container_hint_remove",
        "role_policy",
        "div_policy",
        "image_policy",
        "json_ld_policy",
        "link_density_prune",
        "dedup_policy",
        "mode_policy"
      ]
    },
    "execution_class": {"$ref": "#/$defs/executionClass"},
    "scope": {"$ref": "#/$defs/scope"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
    "enabled": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1},
    "status": {
      "type": "string",
      "enum": ["draft", "published", "deprecated", "archived"]
    },
    "conditions": {"$ref": "#/$defs/conditions"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/action"}
    },
    "override": {"$ref": "#/$defs/override"},
    "safety": {"$ref": "#/$defs/safety"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "created_by": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_by": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actions": {
            "contains": {
              "type": "object",
              "required": ["op"],
              "properties": {"op": {"const": "relocate_element"}}
            }
          }
        },
        "required": ["actions"]
      },
      "then": {"properties": {"schema_version": {"enum": ["1.1", "1.2"]}}}
    },
    {
      "if": {
        "properties": {
          "actions": {
            "contains": {
              "type": "object",
              "anyOf": [
                {"required": ["separator_before"]},
                {"required": ["separator_after"]}
              ]
            }
          }
        },
        "required": ["actions"]
      },
      "then": {"properties": {"schema_version": {"const": "1.2"}}}
    },
    {
      "if": {"properties": {"type": {"const": "link_density_prune"}}},
      "then": {
        "properties": {"execution_class": {"const": "cold-only"}}
      }
    }
  ],
  "$defs": {
    "executionClass": {
      "type": "string",
      "enum": ["streaming", "bounded-buffer", "stateful", "cold-only"]
    },
    "phase": {
      "type": "string",
      "enum": ["prepare", "structural", "normalize", "asset", "finalizer"]
    },
    "nonEmptySelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S",
      "x-maxUtf8Bytes": 512
    },
    "selectorList": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/nonEmptySelector"}
    },
    "scope": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["global", "customer", "page_type", "customer_page_type"]
        },
        "customer": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64},
        "page_type": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64},
        "tenant": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64},
        "locale": {
          "type": "array",
          "items": {"type": "string", "maxLength": 32, "x-maxUtf8Bytes": 32}
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "array",
          "items": {"type": "string", "enum": ["balanced", "aggressive"]}
        },
        "url_include": {
          "type": "array",
          "items": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512}
        },
        "url_exclude": {
          "type": "array",
          "items": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512}
        },
        "host_include": {
          "type": "array",
          "items": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64}
        },
        "host_exclude": {
          "type": "array",
          "items": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64}
        },
        "content_type": {
          "type": "array",
          "items": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64}
        },
        "schedule": {"$ref": "#/$defs/schedule"}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192}
    },
    "schedule": {
      "type": "object",
      "properties": {
        "start_at": {"type": "string"},
        "end_at": {"type": "string"},
        "timezone": {"type": "string"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "oneOf": [
            {"const": "remove_element", "x-runtimeStatus": "implemented", "x-adminSelectable": true},
            {"const": "flatten_element", "x-runtimeStatus": "implemented", "x-adminSelectable": true},
            {"const": "relocate_element", "x-runtimeStatus": "implemented", "x-adminSelectable": true},
            {"const": "remove_attribute", "x-runtimeStatus": "implemented", "x-adminSelectable": true},
            {"const": "keep_attribute", "x-runtimeStatus": "deferred-finalizer", "x-adminSelectable": false},
            {"const": "remove_text_token", "x-runtimeStatus": "not-executed", "x-adminSelectable": false},
            {"const": "remove_text_phrase", "x-runtimeStatus": "not-executed", "x-adminSelectable": false},
            {"const": "protect_element", "x-runtimeStatus": "ordering-only", "x-adminSelectable": false},
            {"const": "promote_tag", "x-runtimeStatus": "not-executed", "x-adminSelectable": false},
            {"const": "inject_json_ld", "x-runtimeStatus": "not-executed", "x-adminSelectable": false},
            {"const": "prune_by_link_density", "x-runtimeStatus": "cold-only", "x-adminSelectable": false}
          ]
        },
        "execution_class": {"$ref": "#/$defs/executionClass"},
        "phase": {"$ref": "#/$defs/phase"},
        "selector": {"$ref": "#/$defs/nonEmptySelector"},
        "target_selector": {"$ref": "#/$defs/nonEmptySelector"},
        "selectors": {"$ref": "#/$defs/selectorList"},
        "attributes": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 80, "x-maxUtf8Bytes": 80}
        },
        "attribute": {"type": "string", "minLength": 1, "maxLength": 80},
        "tokens": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 80, "x-maxUtf8Bytes": 80}
        },
        "phrases": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 200, "x-maxUtf8Bytes": 200}
        },
        "heading_text": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 200, "x-maxUtf8Bytes": 200}
        },
        "min_link_density": {"type": "number", "minimum": 0, "maximum": 1},
        "max_plain_text_chars": {"type": "integer", "minimum": 0},
        "max_buffer_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "separator_before": {"type": "string", "enum": ["", " ", "\n"]},
        "separator_after": {"type": "string", "enum": ["", " ", "\n"]},
        "template": {"not": {"type": "null"}},
        "provides": {"type": "array", "items": {"type": "string"}},
        "requires_after": {"type": "array", "items": {"type": "string"}},
        "reads": {"type": "array", "items": {"type": "string"}},
        "writes": {"type": "array", "items": {"type": "string"}},
        "hardcoded_stage": {"type": "string"},
        "can_disable_hardcoded_stage": {"type": "boolean"},
        "from_role": {"type": "string"}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192},
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {"enum": ["remove_element", "flatten_element", "protect_element"]}
            },
            "required": ["op"]
          },
          "then": {
            "anyOf": [
              {"required": ["selector"]},
              {
                "required": ["selectors"],
                "properties": {"selectors": {"minItems": 1}}
              }
            ]
          }
        },
        {
          "if": {
            "properties": {"op": {"const": "relocate_element"}},
            "required": ["op"]
          },
          "then": {
            "required": ["selector", "target_selector", "max_buffer_bytes"],
            "properties": {
              "execution_class": {"const": "bounded-buffer"},
              "phase": {"const": "normalize"},
              "selectors": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {"required": ["separator_before"]},
              {"required": ["separator_after"]}
            ]
          },
          "then": {
            "properties": {"op": {"const": "flatten_element"}}
          }
        },
        {
          "if": {
            "properties": {"op": {"enum": ["remove_attribute", "keep_attribute"]}},
            "required": ["op"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["attributes"],
                "properties": {"attributes": {"minItems": 1}}
              },
              {"required": ["attribute"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "remove_text_token"}}, "required": ["op"]},
          "then": {"required": ["tokens"], "properties": {"tokens": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"op": {"const": "remove_text_phrase"}}, "required": ["op"]},
          "then": {"required": ["phrases"], "properties": {"phrases": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"op": {"const": "inject_json_ld"}}, "required": ["op"]},
          "then": {"required": ["template"]}
        },
        {
          "if": {"properties": {"op": {"const": "prune_by_link_density"}}, "required": ["op"]},
          "then": {
            "required": ["min_link_density"],
            "properties": {"execution_class": {"const": "cold-only"}}
          }
        },
        {
          "if": {"properties": {"op": {"const": "promote_tag"}}, "required": ["op"]},
          "then": {"anyOf": [{"required": ["selector"]}, {"required": ["from_role"]}]}
        }
      ]
    },
    "override": {
      "type": "object",
      "required": ["group", "strategy"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "strategy": {
          "type": "string",
          "enum": ["append", "replace", "disable_parent", "protect"]
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "destructive": {"type": "boolean"},
        "requires_preview": {"type": "boolean"},
        "protected_selectors": {"$ref": "#/$defs/selectorList"},
        "max_removed_text_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "tags": {
          "type": "array",
          "items": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64}
        },
        "owner": {"type": "string", "maxLength": 160, "x-maxUtf8Bytes": 160},
        "risk_level": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192}
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64},
        "reference": {"type": "string", "maxLength": 160, "x-maxUtf8Bytes": 160},
        "url": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512},
        "note": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192}
    },
    "citation": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "maxLength": 64, "x-maxUtf8Bytes": 64},
        "id": {"type": "string", "maxLength": 160, "x-maxUtf8Bytes": 160},
        "path": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512},
        "url": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512},
        "note": {"type": "string", "maxLength": 512, "x-maxUtf8Bytes": 512}
      },
      "additionalProperties": true,
      "x-runtimeExtraBudget": {"maxFields": 16, "maxJsonBytes": 8192}
    }
  },
  "x-runtimeConstraints": {
    "kvValueMaxBytes": 1048576,
    "jsonLdTemplateMaxBytes": 16384,
    "extraFieldMaxCount": 16,
    "extraJsonMaxBytes": 8192,
    "note": "JSON Schema maxLength counts characters. The runtime additionally enforces UTF-8 byte lengths and serialized JSON byte budgets."
  },
  "x-adminContract": {
    "honorAdminSelectable": true,
    "requireRuntimeValidationBeforePublish": true,
    "customKeywords": ["x-maxUtf8Bytes", "x-runtimeExtraBudget", "x-runtimeConstraints"],
    "note": "The Admin UI must hide or disable actions whose x-adminSelectable value is false. Existing stored rules using those actions remain schema-readable. Standard JSON Schema validation must be followed by runtime validation before publish."
  }
}
