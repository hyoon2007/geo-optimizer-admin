# geo-optimizer-admin BFF 환경변수 예시. 복사해서 bff/.env 로 사용.
# .env 는 .gitignore 대상 — 시크릿을 절대 커밋하지 말 것.

# Spin(geo-optimizer) 베이스 URL
SPIN_BASE_URL=http://127.0.0.1:3000

# Spin 룰 관리 admin 토큰 (geo-optimizer spin.toml의 geo_rule_admin_token과 일치)
# 브라우저에는 절대 전달되지 않는다 — BFF가 x-geo-admin-token 헤더로만 주입.
SPIN_ADMIN_TOKEN=change-me

# 세션 서명 시크릿 (운영 필수, 충분히 긴 랜덤 문자열)
SESSION_SECRET=change-me-to-a-long-random-string

# BFF 포트
PORT=8787

# Spin 없이 BFF 단독 실행 (in-memory mock KV, 개발/데모용)
SPIN_USE_MOCK=false

# KV env/channel (기본 prod/stable)
# GEO_ENV=prod
# GEO_CHANNEL=stable
